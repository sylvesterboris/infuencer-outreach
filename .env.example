# Copy to .env and fill in. Never commit .env.

# Google Cloud console -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# https://console.groq.com/keys (free tier)
GROQ_API_KEY=

# Only needed for sending.mode: smtp
# For Gmail: turn on 2-Step Verification, then create an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
